# syntax=docker/dockerfile:1.7
# 1. 使用 code-server 官方镜像作为基础（已内置 code-server，无需自行安装）
FROM codercom/code-server:latest

# 以 root 安装工具与配置（官方镜像默认用户为 coder，这里切到 root 便于系统级安装）
USER root

# 设置环境变量，避免交互式弹窗
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/root \
    TZ=Asia/Shanghai \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_TARGET=/root/project/.pylibs \
    PYTHONPATH=/root/project/.pylibs

# OCI 元数据标签
LABEL org.opencontainers.image.title="code-server" \
      org.opencontainers.image.description="code-server web IDE (based on codercom/code-server)"

# ------------------------------------------------------------------
# 基础工具 + GitHub CLI（官方镜像基于 Ubuntu，使用其官方源）
#   - 使用 BuildKit 缓存挂载，apt 缓存不写入镜像层
#   - 安装完 gh 后移除仅用于配置源的 gnupg
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    # 设定时区（沿用 Kasm 版一行写法，无需安装 tzdata）
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime; \
    echo $TZ > /etc/timezone; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        curl \
        wget \
        ca-certificates \
        git \
        jq \
        openssh-client \
        build-essential \
        gnupg; \
    # 配置 GitHub CLI 官方 APT 源（复用上面的 apt 缓存）
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    # gnupg 仅用于配置源，安装完 gh 后移除，减小体积
    apt-get purge -y --auto-remove gnupg; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/* /root/.cache/*

# 4.1 安装 Python3（全局装库，配合 PIP_BREAK_SYSTEM_PACKAGES 绕过 PEP 668）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv; \
    # 建立 python -> python3 软链接，方便直接使用 python 命令
    ln -sf /usr/bin/python3 /usr/local/bin/python; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 4.3 校验 Node 与 code-server 可用（官方镜像已内置，无需自行安装）
RUN node --version && code-server --version

# 5. 创建工作区与配置目录（直接用 root，避免非 root 权限问题）
RUN mkdir -p /root/.config/code-server \
    && mkdir -p /root/project \
    && mkdir -p /root/project/.pylibs

# 预初始化 git 工作区（默认分支 main，供 code-server 与 GitHub 联动）
RUN git init -b main /root/project \
    && git config --global --add safe.directory /root/project \
    && git config --global init.defaultBranch main \
    && git config --global pull.rebase false

# 预置 .gitignore，避免把持久化的 Python 库目录误提交
COPY <<EOF /root/project/.gitignore
.pylibs/
__pycache__/
*.pyc
node_modules/
.venv/
EOF

# 使用 Dockerfile 原生 heredoc 写入 code-server 默认配置
COPY <<EOF /root/.config/code-server/config.yaml
bind-addr: 0.0.0.0:8080
auth: password
password: YourStrongPasswordHere
cert: false
EOF

# 设置工作目录，启动后即为 /root/project（大家共用同一工作区）
WORKDIR /root/project

EXPOSE 8080

# 6. 启动命令（root 身份运行，打开 /root/project 工作区）
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "/root/project"]