# syntax=docker/dockerfile:1.7
# 1. 使用 Debian 官方 stable-slim 镜像作为基础镜像（跟随当前 stable 分支）
FROM debian:stable-slim

# 设置环境变量，避免交互式弹窗
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    HOME=/root \
    TZ=Asia/Shanghai \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_TARGET=/root/project/.pylibs \
    PYTHONPATH=/root/project/.pylibs

# OCI 元数据标签
LABEL org.opencontainers.image.title="code-server" \
      org.opencontainers.image.description="Debian-based code-server web IDE"

# ------------------------------------------------------------------
# 优化点①：使用 BuildKit 缓存挂载 + 合并所有 apt 操作为单层
#   - apt 缓存不写入镜像层（--mount=type=cache），减小体积
#   - 基础依赖与 gh 官方源在同一层完成，避免重复 apt-get update
#   - 安装完 gh 后移除仅用于配置源的 gnupg
#   - 保留 wget 便于后续安装软件
#   - 使用 Debian 官方源（stable），不做国内加速
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    # 设定时区（沿用 Kasm 版一行写法，无需安装 tzdata）
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime; \
    echo $TZ > /etc/timezone; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        curl \
        wget \
        ca-certificates \
        git \
        jq \
        openssh-client \
        build-essential \
        gnupg; \
    # 配置 GitHub CLI 官方 APT 源（复用上面的 apt 缓存）
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends gh; \
    # gnupg 仅用于配置源，安装完 gh 后移除，减小体积
    apt-get purge -y --auto-remove gnupg; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 4. 安装 code-server（standalone 方式，避免重复安装系统依赖）
RUN curl -fsSL https://code-server.dev/install.sh | sh -s -- --method=standalone \
    && rm -rf /tmp/* /var/tmp/*

# 4.1 安装 Python3（全局装库，配合 PIP_BREAK_SYSTEM_PACKAGES 绕过 PEP 668）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv; \
    # 建立 python -> python3 软链接，方便直接使用 python 命令
    ln -sf /usr/bin/python3 /usr/local/bin/python; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 4.2 使用 NodeSource 安装 Node.js 22 LTS（替换 Debian 仓库的旧版 Node）
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    # 导入 NodeSource 签名并添加 Node 22 源
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends nodejs; \
    # 清理配置用的 gnupg
    apt-get purge -y --auto-remove gnupg; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# 5. 创建工作区与配置目录（直接用 root，避免非 root 权限问题）
RUN mkdir -p /root/.config/code-server \
    && mkdir -p /root/project \
    && mkdir -p /root/project/.pylibs

# 预初始化 git 工作区（默认分支 main，供 code-server 与 GitHub 联动）
RUN git init -b main /root/project \
    && git config --global --add safe.directory /root/project \
    && git config --global init.defaultBranch main \
    && git config --global pull.rebase false

# 预置 .gitignore，避免把持久化的 Python 库目录误提交
COPY <<EOF /root/project/.gitignore
.pylibs/
__pycache__/
*.pyc
node_modules/
.venv/
EOF

# 使用 Dockerfile 原生 heredoc 写入 code-server 默认配置
COPY <<EOF /root/.config/code-server/config.yaml
bind-addr: 0.0.0.0:8080
auth: password
password: YourStrongPasswordHere
cert: false
EOF

# 设置工作目录，启动后即为 /root/project（大家共用同一工作区）
WORKDIR /root/project

EXPOSE 8080

# 6. 启动命令（root 身份运行，打开 /root/project 工作区）
CMD ["code-server", "--bind-addr", "0.0.0.0:8080", "/root/project"]